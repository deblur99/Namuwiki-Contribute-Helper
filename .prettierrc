{
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "proseWrap": "preserve",
  "endOfLine": "auto",
  "overrides": [
    {
      "files": ["*.json", "*.jsonc"],
      "options": {
        "tabWidth": 2,
        "useTabs": false,
        "printWidth": 100,
        "endOfLine": "auto"
      }
    },
    {
      "files": ["*.md", "*.mdx"],
      "options": {
        "tabWidth": 2,
        "useTabs": false,
        "proseWrap": "preserve",
        "printWidth": 9999,
        "endOfLine": "auto"
      }
    }
  ]
}
