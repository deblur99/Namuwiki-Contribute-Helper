/*
ProfileTable — 인포박스(프로필 표) 재사용 템플릿 예제
스펙: wiki-kit/docs/SPEC.nwiki
사용: import ProfileTable from "./ProfileTable.nwiki"
*/

/// 인포박스(프로필 표) 재사용 컴포넌트.
///
/// - **props**: `name` (표시 이름)
/// - 사용: `import ProfileTable from "…"` 후 `<ProfileTable name="…" />`

props {
  name: required
}

<template>
  <Table
    width=LayoutLength(500)
    align=.right
    <!-- borderColor=HexColor(light="#87CEEB", dark="#00BFFF") -->
    <!-- borderColor=HexColor("#87CEEB") -->
    borderColor=HexColor("#00BFFF")
    bgColor=HexColor(light="#FFFFFF", dark="#1C1D1F")>

    <TableRow>
      <TableColumn colSpan=2 bgColor=HexColor("#87CEEB")>
        <TitleText text="${props.name}" />
      </TableColumn>
    </TableRow>

    <TableRow>
      <TableColumn colSpan=2 nopad=true>
        <Image fileName="김마리_새파란신드롬_프로필.jpg" width=LayoutLength(100, .percent) />
      </TableColumn>
    </TableRow>

    <TableRow>
      <TableColumn width=LayoutLength(85)>
        <Text text="본명" weight=.bold />
      </TableColumn>

      <TableColumn>
        <Text text="김현지" />
      </TableColumn>
    </TableRow>

    <TableRow>
      <TableColumn width=LayoutLength(85)>
        <Text text="출생" weight=.bold />
      </TableColumn>

      <TableColumn delimiter=" ">
        <Link toDocument="1994년" />
        <Link toDocument="5월 6일" />
        <Text text="(${age(Date(year: 1994, month: 5, day: 6))}세)" />
      </TableColumn>
    </TableRow>

    <TableRow>
      <TableColumn>
        <Text text="국적" weight=.bold />
      </TableColumn>

      <TableColumn delimiter=" ">
        <Image fileName="대한민국 국기.svg" width=LayoutLength(28) />
        <Link toDocument="대한민국" />
      </TableColumn>
    </TableRow>

    <TableRow>
      <TableColumn>
        <Text text="데뷔" weight=.bold />
      </TableColumn>

      <TableColumn>
        <Link toDocument="2018년" />
        <Space />
        <Link toDocument="3월 16일" />
        <Space />
        <Text text="'기억을 안아주는 방법'" />
        <br />
        <Text text="D${dday(Date(year: 2018, month: 3, day: 16))}일" weight=.bold />
      </TableColumn>
    </TableRow>

    <TableRow>
      <TableColumn>
        <Text text="학력" weight=.bold />
      </TableColumn>

      <TableColumn>
        <Link toDocument="경희대학교/학부/예술·디자인대학" label="경희대학교 예술·디자인대학" />
        <Space />
        <Text text="(포스트모던음악학 / 학사)" size=.step(-2) />
        <Comment text="15학번" />
      </TableColumn>
    </TableRow>

    <TableRow>
      <TableColumn>
        <Text text="SNS" weight=.bold />
      </TableColumn>

      <TableColumn delimiter=" | ">
        <Link toExternal="https://www.instagram.com/for.marie/">
          <Image fileName="인스타그램 아이콘.svg" width=LayoutLength(20) />
        </Link>
        <Link toExternal="https://www.youtube.com/channel/UCZEEMIdKlyvk6MC1u65WIHw">
          <Image fileName="유튜브 아이콘.svg" width=LayoutLength(20) />
        </Link>
        <Link toExternal="https://soundcloud.com/formarie0-0">
          <Image fileName="사운드클라우드 아이콘.svg" width=LayoutLength(20) />
        </Link>
        <Link toExternal="https://gall.dcinside.com/kimmarie">
          <Image fileName="디시인사이드 아이콘.svg" width=LayoutLength(20) />
        </Link>
      </TableColumn>
    </TableRow>

    <TableRow>
      <TableColumn>
        <Text text="MBTI" weight=.bold />
      </TableColumn>

      <TableColumn>
        <Link toDocument="ISTP" />
        <Comment text="예전에는 다른 유형이었는데 시간이 지나면서 바뀌었다고 한다." />
      </TableColumn>
    </TableRow>

    <TableRow>
      <TableColumn>
        <Text text="별명" weight=.bold />
      </TableColumn>

      <TableColumn delimiter=", ">
        <Text text="마또울" />
        <Comment>
          <Text text="공연 때 자주 울어서 생긴 별명. '마리 또 울어요' " />
          <Text text="정작 아티스트는 별로 안 좋아한다." decoration=[.line-through] />
        </Comment>

        <Text text="짱마리" />
        <Comment text="팬 단톡방에 출현할 때의 닉네임인 마리'짱'과 '대단함'을 뜻하는 '짱'을 섞어, '짱'마리. 입에 잘 붙어서 팬들이 많이 사용한다." />
      </TableColumn>
    </TableRow>
  </Table>
</template>


