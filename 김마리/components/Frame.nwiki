/*
Frame — 김마리(가수) 둘러보기 틀
스펙: wiki-kit/docs/SPEC.nwiki
사용: includeFrame("김마리(가수)") → [include(틀:김마리(가수))]
*/

frame("김마리(가수)") /*  document("틀:김마리(가수)") 와 동일 */

import DesignSystem from "../data/design-system.json"

/// 둘러보기 틀 헤더(로고 + 제목)와 하위 문서 내비 링크 줄.
category("둘러보기 틀/밴드")
category("김마리(가수)")

extension DesignSystem {
  static let defaultColor = HexColor(light: #222, dark: #ddd)
  static let defaultBgColor = HexColor(light: #ddd, dark: #222)
}

<template>
  <Table width=LayoutLength(100, .percent) bgColor=HexColor("${DesignSystem.accentColor}")>
    <TableRow>
      <TableColumn alignment=.center>
        <Link toDocument="김마리(가수)">
          <Box display=.flex flexDirection=.row justifyContent=.center alignItems=.center>
            <Image fileName="마도리_로고.png" width=LayoutLength(100) />
            <Box
              display=.flex
              flexDirection=.column
              alignItems=.flexStart>
              <Text
                text="김마리"
                size=.step(1)
                color=HexColor("${DesignSystem.white}")
                weight=.bold
              />
              <Text
                text="관련 문서"
                size=.step(-1)
                weight=.bold
                color=HexColor("${DesignSystem.white}")
              />
            </Box>
          </Box>

        </Link>

      </TableColumn>
    </TableRow>

    <TableRow>
      <TableColumn alignment=.center delimiter=" · " bgColor="${DesignSystem.defaultBgColor}">
        <Link toDocument="김마리(가수)">
          <Text text="소개" size=.step(-2) />
        </Link>
        <Link toDocument="김마리(가수)/음반 목록">
          <Text text="음반 목록" size=.step(-2) />
        </Link>
        <Link toDocument="김마리(가수)/공연 목록">
          <Text text="공연 목록" size=.step(-2) />
        </Link>
        <Link toDocument="김마리(가수)/응원법">
          <Text text="응원법" size=.step(-2) />
        </Link>
        <Link toDocument="김마리(가수)#s-4">
          <Text text="여담" size=.step(-2) />
        </Link>
      </TableColumn>
    </TableRow>

  </Table>
</template>


