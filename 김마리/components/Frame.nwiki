/*
Frame — 김마리(가수) 둘러보기 틀
스펙: wiki-kit/docs/SPEC.nwiki
사용: includeFrame("김마리(가수)") → [include(틀:김마리(가수))]
*/

/// 둘러보기 틀 헤더(로고 + 제목)와 하위 문서 내비 링크 줄.
category("둘러보기 틀/밴드")
category("김마리(가수)")

<script>
  import("../data/designSystem.json")
</script>

<template>
  <Table width=LayoutLength(100, .percent)>

    <TableRow>
      <TableColumn
        alignment=.center
        bgColor=HexColor("${designSystem.accentColor}")>
        <Box
          margin=Spacing(vertical: -5, horizontal: -10)
          padding=Spacing(vertical: 5, horizontal: 10)>
          <Link toDocument="김마리(가수)">
            <Row inline=true crossAxisAlignment=.center spacing=4>
              <Image fileName="마도리_로고.png" width=LayoutLength(100) />
              <Column
                crossAxisAlignment=.start
                textAlign=.left
                color=HexColor("${designSystem.whiteShort}")>
                <TitleText text="김마리" />
                <Text text="관련 문서" size=.step(-1) weight=.bold />
              </Column>
            </Row>
          </Link>
        </Box>
      </TableColumn>
    </TableRow>

    <TableRow>
      <TableColumn alignment=.center delimiter=" · ">
        <Link toDocument="김마리(가수)">
          <Text text="소개" size=.step(-2) />
        </Link>
        <Link toDocument="김마리(가수)/음반 목록">
          <Text text="음반 목록" size=.step(-2) />
        </Link>
        <Link toDocument="김마리(가수)/공연 목록">
          <Text text="공연 목록" size=.step(-2) />
        </Link>
        <Link toDocument="김마리(가수)/응원법">
          <Text text="응원법" size=.step(-2) />
        </Link>
        <Link toDocument="김마리(가수)#s-4">
          <Text text="여담" size=.step(-2) />
        </Link>
      </TableColumn>
    </TableRow>

  </Table>
</template>


