/*
JSON import("….json") 예제 — stem 네임스페이스로 ${designSystem.key} 주입
*/
import("./data/designSystem.json")

<template>
  <Table
    width=LayoutLength(500)
    align=.right
    borderColor=HexColor("${designSystem.accentColor}")
    bgColor=HexColor(light="${designSystem.white}", dark="#1C1D1F")>
    <TableRow>
      <TableColumn colSpan=2 bgColor=HexColor("${designSystem.accentColor}")>
        <TitleText text="데이터 주입" />
      </TableColumn>
    </TableRow>
    <TableRow>
      <TableColumn colSpan=2 nopad=true>
        <Image fileName="${designSystem.profileImage}" width=LayoutLength(100, .percent) />
      </TableColumn>
    </TableRow>
  </Table>
</template>
