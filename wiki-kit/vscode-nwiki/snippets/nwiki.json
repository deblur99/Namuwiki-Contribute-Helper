{
  "Table skeleton": {
    "prefix": "tbl",
    "body": [
      "<Table width=LayoutLength(${1:500}) align=.${2|right,center,left|} borderColor=HexColor(\"${3:#87CEEB}\") bgColor=HexColor(light=\"${4:#FFFFFF}\" dark=\"${5:#1C1D1F}\")>",
      "\t<TableRow>",
      "\t\t<TableColumn>",
      "\t\t\t$0",
      "\t\t</TableColumn>",
      "\t</TableRow>",
      "</Table>"
    ],
    "description": "Table with one row/column"
  },
  "TableRow + Column": {
    "prefix": "tr",
    "body": [
      "<TableRow>",
      "\t<TableColumn$1>",
      "\t\t$0",
      "\t</TableColumn>",
      "</TableRow>"
    ],
    "description": "TableRow with TableColumn"
  },
  "TableColumn": {
    "prefix": "tc",
    "body": [
      "<TableColumn$1>",
      "\t$0",
      "</TableColumn>"
    ],
    "description": "TableColumn"
  },
  "Text": {
    "prefix": "tx",
    "body": "<Text text=\"${1}\" />",
    "description": "Text (required: text)"
  },
  "Link": {
    "prefix": "lk",
    "body": "<Link toDocument=\"${1}\" />",
    "description": "Link (택1: toDocument | toExternal)"
  },
  "Link labeled": {
    "prefix": "lkl",
    "body": "<Link toDocument=\"${1}\" label=\"${2:표시}\" />",
    "description": "Link with different display label"
  },
  "document": {
    "prefix": "doc",
    "body": "document(\"${1:문서명}\")",
    "description": "Current wiki document title for ./ ../ toDocument"
  },
  "Comment": {
    "prefix": "cmt",
    "body": "<Comment text=\"${1:주석}\" />",
    "description": "Footnote comment"
  },
  "category": {
    "prefix": "cat",
    "body": "category(\"${1:분류}\")",
    "description": "category() call"
  },
  "include": {
    "prefix": "inc",
    "body": "include(\"${1:틀:이름}\")",
    "description": "include() call — full wiki document title"
  },
  "includeFrame": {
    "prefix": "incf",
    "body": "includeFrame(\"${1:이름}\")",
    "description": "includeFrame() sugar — prefixes 틀:"
  },
  "includeFrame CommonFrame": {
    "prefix": "incfc",
    "body": "includeFrame(.${1|adult,spoiler,parentDocument(\"문서\"),relatedDocuments(\"A\", \"B\"),discussion(\"사유\"),accessRestricted|})",
    "description": "includeFrame(.CommonFrame …)"
  },
  "includeFrame adult": {
    "prefix": "incfa",
    "body": "includeFrame(.adult)",
    "description": "틀:선정성 (19금)"
  },
  "includeFrame discussion": {
    "prefix": "incfd",
    "body": "includeFrame(.discussion(\"${1:사유}\"))",
    "description": "틀:토론 중"
  },
  "includeFrame related": {
    "prefix": "incfr",
    "body": "includeFrame(.relatedDocuments(\"${1}\", \"${2}\"))",
    "description": "틀:관련 문서"
  },
  "HexColor": {
    "prefix": "hex",
    "body": "HexColor(\"${1:#FFFFFF}\")",
    "description": "HexColor init"
  },
  "TextSize.step": {
    "prefix": "tsz",
    "body": "TextSize.step(${1:1})",
    "description": "TextSize.step(n)"
  },
  "import from": {
    "prefix": "imp",
    "body": [
      "import ${1:DesignSystem} from \"${2:./data/design-system.json}\"",
      "$0"
    ],
    "description": "import Name from \"path\" (.json | .nwiki)"
  },
  "import component": {
    "prefix": "impc",
    "body": [
      "import ${1:ProfileTable} from \"${2:./components/ProfileTable.nwiki}\"",
      "$0"
    ],
    "description": "import component from .nwiki"
  },
  "props block": {
    "prefix": "props",
    "body": [
      "props {",
      "\t${1:name}: required",
      "\t${2:age}",
      "}"
    ],
    "description": "Component props { name: required, age }"
  },
  "Starter Frame": {
    "prefix": "nwframe",
    "body": [
      "frame(\"${1:문서명}\")",
      "",
      "import DesignSystem from \"${2:../data/design-system.json}\"",
      "",
      "category(\"둘러보기 틀\")",
      "category(\"${1:문서명}\")",
      "",
      "<template>",
      "\t<Table width=LayoutLength(100 .percent) bgColor=HexColor(\"\\${DesignSystem.accentColor}\")>",
      "\t\t<TableRow>",
      "\t\t\t<TableColumn alignment=.center>",
      "\t\t\t\t<Link toDocument=\"${1:문서명}\">",
      "\t\t\t\t\t<Text text=\"${3:제목}\" size=.step(1) color=HexColor(\"\\${DesignSystem.white}\") weight=.bold />",
      "\t\t\t\t</Link>",
      "\t\t\t</TableColumn>",
      "\t\t</TableRow>",
      "\t\t<TableRow>",
      "\t\t\t<TableColumn alignment=.center delimiter=\" · \" bgColor=\"\\${DesignSystem.defaultBgColor}\">",
      "\t\t\t\t<Link toDocument=\"${1:문서명}\"><Text text=\"소개\" size=.step(-2) /></Link>",
      "\t\t\t\t<Link toDocument=\"${1:문서명}/하위\"><Text text=\"하위\" size=.step(-2) /></Link>",
      "\t\t\t</TableColumn>",
      "\t\t</TableRow>",
      "\t</Table>",
      "</template>",
      "$0"
    ],
    "description": "Frame starter (prefer: nwiki: Insert Frame Template — uses document title)"
  },
  "Starter ProfileTable": {
    "prefix": "nwprofile",
    "body": [
      "props {",
      "\tname: required",
      "}",
      "",
      "<template>",
      "\t<Table width=LayoutLength(500) align=.right borderColor=HexColor(\"#00BFFF\") bgColor=HexColor(light=\"#FFFFFF\" dark=\"#1C1D1F\")>",
      "\t\t<TableRow>",
      "\t\t\t<TableColumn colSpan=2 bgColor=HexColor(\"#87CEEB\")>",
      "\t\t\t\t<TitleText text=\"\\${props.name}\" />",
      "\t\t\t</TableColumn>",
      "\t\t</TableRow>",
      "\t\t<TableRow>",
      "\t\t\t<TableColumn colSpan=2 nopad=true>",
      "\t\t\t\t<Image fileName=\"${1:프로필.jpg}\" width=LayoutLength(100 .percent) />",
      "\t\t\t</TableColumn>",
      "\t\t</TableRow>",
      "\t\t<TableRow>",
      "\t\t\t<TableColumn width=LayoutLength(85)><Text text=\"본명\" weight=.bold /></TableColumn>",
      "\t\t\t<TableColumn><Text text=\"${2}\" /></TableColumn>",
      "\t\t</TableRow>",
      "\t</Table>",
      "</template>",
      "$0"
    ],
    "description": "ProfileTable starter (prefer: nwiki: Insert ProfileTable Template)"
  },
  "Starter Article": {
    "prefix": "nwpage",
    "body": [
      "document(\"${1:문서명}\")",
      "",
      "import DesignSystem from \"./data/design-system.json\"",
      "import ProfileTable from \"./components/ProfileTable.nwiki\"",
      "",
      "category(\"${1:문서명}\")",
      "includeFrame(\"${1:문서명}\")",
      "",
      "<template>",
      "\t<ProfileTable name=\"${2:이름}\" />",
      "\t<Heading toDocument=\"./하위\" title=\"하위\" />",
      "\t<Heading title=\"여담\">",
      "\t\t<Quote>",
      "\t\t</Quote>",
      "\t\t<Text text=\"$0\" />",
      "\t</Heading>",
      "</template>"
    ],
    "description": "Article page starter (prefer: nwiki: Insert Article Template — uses document title)"
  },
  "Box": {
    "prefix": "box",
    "body": [
      "<Box display=.flex flexDirection=.column justifyContent=.flexStart alignItems=.stretch gap=${1:0}$2>",
      "\t$0",
      "</Box>"
    ],
    "description": "Box (default flex column + gap)"
  },
  "Box flex row": {
    "prefix": "boxflex",
    "body": [
      "<Box display=.flex flexDirection=.row justifyContent=.flexStart alignItems=.center gap=${1:0}$2>",
      "\t$0",
      "</Box>"
    ],
    "description": "Flex Box row (gap)"
  },
  "Heading": {
    "prefix": "hd",
    "body": "<Heading title=\"${1}\" />",
    "description": "Heading (required: title)"
  },
  "Heading collapsed": {
    "prefix": "hdc",
    "body": "<Heading title=\"${1}\" collapsed=true />",
    "description": "Collapsed paragraph heading (==# … #==)"
  },
  "Heading linked": {
    "prefix": "hdl",
    "body": "<Heading title=\"${1}\" toDocument=\"${2:./하위}\" />",
    "description": "Heading with optional toDocument"
  },
  "Image": {
    "prefix": "img",
    "body": "<Image fileName=\"${1}\" />",
    "description": "Image (택1: fileName | src)"
  },
  "Folding": {
    "prefix": "fold",
    "body": [
      "<Folding title=\"${1}\">",
      "\t$0",
      "</Folding>"
    ],
    "description": "Folding (required: title)"
  },
  "Quote": {
    "prefix": "quote",
    "body": [
      "<Quote>",
      "\t<Text text=\"${1:인용구}\" weight=.bold />",
      "$0",
      "</Quote>"
    ],
    "description": "Namuwiki blockquote (> …)"
  },
  "Badge": {
    "prefix": "badge",
    "body": [
      "<Badge bgColor=HexColor(\"${1:#5C775E}\")>",
      "\t<Text text=\"${2:라벨}\" weight=.bold />",
      "</Badge>"
    ],
    "description": "Badge chip sugar"
  },
  "LinearGradient Box": {
    "prefix": "boxgrad",
    "body": [
      "<Box background=LinearGradient(.toRight HexColor(\"${1:#FFB9B9}\") HexColor(\"${2:#FFFDBB}\")) opacity=${3:1}>",
      "\t$0",
      "</Box>"
    ],
    "description": "Box with LinearGradient background"
  }
}
