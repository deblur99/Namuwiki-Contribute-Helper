{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run nwiki Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/wiki-kit/vscode-nwiki",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/wiki-kit/vscode-nwiki/out/**/*.js"],
      "preLaunchTask": "npm: compile - vscode-nwiki",
      "stopOnEntry": false,
      "noDebug": true,
      "timeout": 60000
    },
    {
      "name": "Debug nwiki Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/wiki-kit/vscode-nwiki",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/wiki-kit/vscode-nwiki/out/**/*.js"],
      "preLaunchTask": "npm: compile - vscode-nwiki",
      "stopOnEntry": false,
      "timeout": 60000
    }
  ]
}
